# Postgres connection string. On Neon: Project -> Connect -> copy the pooled connection string.
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Use sslmode=verify-full (not "require") so the pg driver does not print a security warning.
DATABASE_URL=

# Secret used to sign login sessions. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google Gemini API key, used only to categorise merchants the built-in rules don't know.
# Get one free at https://aistudio.google.com/apikey . Leave empty to run without AI (unknown merchants stay "Other").
GEMINI_API_KEY=

# Optional: which Gemini model to try first. Defaults to gemini-flash-lite-latest (fast; labelling payees is a simple task).
GEMINI_MODEL=

# Only for `npm run db:seed`: login for the demo account the seed script creates. Not needed in production.
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
